-- [[ LÓGICA DE EXECUÇÃO DA LOADSTRING DA ATUALIZAÇÃO ]] --
ExecuteButton.MouseButton1Click:Connect(function()
    ExecuteButton.Text = "INJETANDO SCRIPTS..."
    ExecuteButton.BackgroundColor3 = Color3.fromRGB(200, 150, 40)
    task.wait(0.5)
    
    local sucesso, erro = pcall(function()
        -- Roda direto a API do Luarmor que você mandou
        loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/4595fe31a5f7a8b4f4dd7071f3119ef7.lua"))()
    end)
    
    if sucesso then
        ExecuteButton.Text = "AUTO FARM ATIVADO! 😎"
        ExecuteButton.BackgroundColor3 = Color3.fromRGB(30, 120, 70)
        
        -- Notificação do Roblox confirmando
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "José Hub",
            Text = "Scripts injetados com sucesso pós-atualização!",
            Duration = 5
        })
    else
        ExecuteButton.Text = "ERRO AO CARREGAR INTERNO"
        ExecuteButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        warn("Erro ao injetar Luarmor: ", erro)
    end
end)
